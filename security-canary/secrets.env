# INTENTIONALLY PLANTED DUMMY CREDENTIALS — SECURITY PIPELINE CANARY
# These match the regex patterns used by GitLeaks / TruffleHog / detect-secrets.
# They are NOT live credentials.

# AWS (AWS's own documented example pair — matches AKIA[0-9A-Z]{16})
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# GitHub classic PAT pattern (ghp_ + 36 chars)
GITHUB_TOKEN=ghp_000000000000000000000000000000000000

# Slack webhook pattern
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX

# Generic private key block (triggers PEM detectors)
-----BEGIN RSA PRIVATE KEY-----
MIIEpAIBAAKCAQEAexampleexampleexampleexampleexampleexampleexample
exampleexampleexampleexampleexampleexampleexampleexampleexampleex
-----END RSA PRIVATE KEY-----
